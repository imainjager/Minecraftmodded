		{
			id: "0FCA81A1A781EEFD"
			title: "Welcome to Forged Ascent"
			x: 0.0d
			y: 0.0d
			subtitle: "Read me first"
			description: [
				"This world has a long gear ladder: &etiers 1 to 9&r. Every ore needs a pickaxe of its tier: a &6stone&r pickaxe can't mine iron any more."
				"Tier 4+ gear is forged at &bSmithy Anvils&r. Each new anvil needs a &dSigil&r from a &cboss gate&r, Terraria style. Follow these chapters in order."
				"Mobs grow stronger with your Apotheosis world tier, deep underground and in other dimensions. Elites (Brutes, Runners, Dread...) appear more as you climb."
			]
			icon: {
				id: "forgedascent:tin_pickaxe"
			}
			shape: "gear"
